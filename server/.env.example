PORT=5000
MONGODB_URI=mongodb://localhost:27017/meeting-room-booking
JWT_SECRET=your_super_secret_jwt_key_change_in_production
# Access token lifetime. Short on purpose: the client silently refreshes it
# with the long lived refresh token. Units: s, m, h, d.
JWT_EXPIRE=15m
# Refresh token lifetime in days. Rotated on every use and stored hashed.
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_URL=http://localhost:5173
NODE_ENV=development
BCRYPT_ROUNDS=12
# --- Rate limiting (production values) ---
# General API requests per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Failed login/register attempts per IP (successes are never counted)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Failed login/register attempts per account (stops credential stuffing
# spread across many IPs)
AUTH_ACCOUNT_LIMIT_WINDOW_MS=900000
AUTH_ACCOUNT_LIMIT_MAX=10
# Image uploads (profile photo, room photo) per IP
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=20

